<?xml version="1.0" encoding="utf-8"?>
<!-- 잠근 앱을 열었을 때 아래에서 올라오는 창. 어두워진 바탕 위에 카드 한 장만 둔다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B31F1A17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_lock_card"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="12dp"
        android:paddingEnd="26dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_lock_grip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_lock_circle"
                android:elevation="2dp"
                android:padding="12dp"
                android:src="@drawable/symbol" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_lock_pill"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="잠금 중"
                android:textColor="#E8592C"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/lock_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="#E8592C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="4dp"
            android:text="오늘 몫을 끝내면\n바로 열려요"
            android:textColor="#2A2420"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="5dp"
            android:text="오늘 할 일을 모두 인증하면 잠금이 풀려요. 전화와 메신저, 검색은 그대로 쓸 수 있어요."
            android:textColor="#857A6E"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lock_go"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_lock_button"
            android:gravity="center"
            android:text="인증하러 가기"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lock_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="닫기"
            android:textColor="#857A6E"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="오늘이 버겁다면 Do-er에서 코치에게 사정을 말해 주세요"
            android:textColor="#B5AA9C"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
