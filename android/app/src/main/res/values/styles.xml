<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- 잠금 화면: 화면 전체를 깊은 밤색으로 덮고, 천천히 밝아지며 나타난다. -->
    <style name="LockTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_lock_night</item>
        <item name="android:statusBarColor">#1B1613</item>
        <item name="android:navigationBarColor">#1B1613</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@style/LockAnimation</item>
    </style>
    <style name="LockAnimation">
        <item name="android:windowEnterAnimation">@anim/lock_in</item>
        <item name="android:windowExitAnimation">@anim/lock_out</item>
        <item name="android:activityOpenEnterAnimation">@anim/lock_in</item>
        <item name="android:activityCloseExitAnimation">@anim/lock_out</item>
    </style>
    <color name="cream">#FBF7F0</color>
    <color name="night">#1D1815</color>
    <color name="coral">#E8592C</color>
</resources>
