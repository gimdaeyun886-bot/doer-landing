# .env.local 로 복사해 값을 채운다. 값은 저장소에 올리지 않는다(.gitignore).
# Supabase 대시보드 > Project Settings > API 에서 확인한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI 코치(대화, 계획, 인증 판정, 조정). OpenAI 호환 API 키. 중계 서비스를 쓸 때만 BASE_URL을 채운다.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# (선택) AI 사용 상한. 비우면 기본값을 쓴다.
# 최근 7일 동안 데모 전체가 쓸 수 있는 금액(달러, 기본 10)과 토큰 백만 개당 값(기본 입력 5, 출력 20).
AI_BUDGET_USD=
AI_PRICE_IN=
AI_PRICE_OUT=
