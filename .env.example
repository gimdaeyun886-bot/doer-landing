# 이 파일을 .env.local 로 복사한 뒤 값을 채웁니다. 실제 값은 GitHub에 올리지 않습니다.
# Supabase 대시보드 → Project Settings → API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
# publishable 키 (예전 이름: anon 키). service_role(secret) 키는 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# OpenAI API 키 (비밀 키). 코치 대화와 계획 생성에 씁니다. 브라우저로 넘어가지 않게 NEXT_PUBLIC_ 을 붙이지 않습니다.
OPENAI_API_KEY=
# 선택: 모델 이름. 비우면 기본 모델을 씁니다.
OPENAI_MODEL=
# 선택: 가입 화면에 보여 줄 소셜 로그인. Supabase에서 켠 것만 적습니다. 예: google,kakao
NEXT_PUBLIC_AUTH_PROVIDERS=

# AI 예산. 비우면 괄호 안의 값을 쓴다.
# 최근 7일 동안 모든 사용자가 쓸 수 있는 금액(70), 한 사람의 몫(10), 토큰 백만 개의 값: 입력(5), 출력(20). 단위는 달러.
AI_BUDGET_USD=
AI_USER_BUDGET_USD=
AI_PRICE_IN=
AI_PRICE_OUT=
