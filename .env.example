# 이 파일을 .env.local 로 복사한 뒤 값을 채웁니다. 실제 값은 GitHub에 올리지 않습니다.
# Supabase 대시보드 → Project Settings → API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
# publishable 키 (예전 이름: anon 키). service_role(secret) 키는 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Claude API 키 (비밀 키). AI 계획 생성에 씁니다. 브라우저로 나가지 않게 NEXT_PUBLIC_ 을 붙이지 않습니다.
ANTHROPIC_API_KEY=
